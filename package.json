{
  "name": "poker-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "socket": "node socket-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run socket\"",
    "cypress:install": "npx cypress install",
    "cypress:open": "npx cypress open",
    "cypress:run": "npx cypress run",
    "cypress:headless": "npx cypress run --headless",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:e2e:headless": "start-server-and-test dev http://localhost:3000 cypress:headless",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.42.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.5",
    "next": "16.2.9",
    "next-auth": "^4.24.10",
    "react": "19.2.4",
    "react-confetti": "^6.4.0",
    "react-dom": "19.2.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "concurrently": "^8.2.2",
    "cypress": "^13.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.0",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^4.0.0"
  }
}