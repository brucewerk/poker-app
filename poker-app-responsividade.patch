index f99cf29..87e5153 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -3034,3 +3034,206 @@ canvas {
     opacity: 0.85;
   }
 }
+
+/* ================================================================
+   🔧 CORREÇÃO DE RESPONSIVIDADE MOBILE — MESA FIXA + AÇÕES VISÍVEIS
+   ------------------------------------------------------------------
+   Este bloco fica por último de propósito: como várias regras acima
+   usam !important em seletores de mesma especificidade, a ordem no
+   arquivo decide o empate — então o que está aqui embaixo é o que
+   vale. Ele resolve, para tela de toque (celular/tablet):
+
+   1) Nunca precisar rolar a página para alcançar os botões de ação,
+      em retrato OU paisagem — a mesa e os botões vivem dentro de uma
+      "casca" (app shell) do tamanho exato da tela, com o topo (mesa)
+      flexível e o rodapé (botões) sempre fixo e visível.
+   2) A mesa não "pular" de tamanho durante a partida — usamos
+      100svh (small viewport height, estável) em vez de 100vh, e a
+      página deixa de rolar sozinha, então o navegador não fica
+      escondendo/mostrando a barra de endereço (que era o gatilho
+      dos recálculos de layout no meio da mão).
+   3) Os painéis laterais (stats, nível, amigos, missões, histórico)
+      saem do fluxo principal — em vez de empilhar embaixo da mesa
+      empurrando os botões para fora da tela, viram um painel que
+      abre por cima ao tocar em "📊".
+   ================================================================ */
+
+.mobile-sidebar-toggle,
+.mobile-sidebar-close {
+  display: none;
+}
+
+@media (max-width: 1024px), (hover: none) and (pointer: coarse) {
+  html,
+  body {
+    height: 100%;
+    overflow: hidden !important;
+    overscroll-behavior: none;
+  }
+
+  .game-shell {
+    display: flex !important;
+    flex-direction: column !important;
+    height: 100svh !important;
+    height: 100dvh !important;
+    min-height: 0 !important;
+    max-height: 100svh !important;
+    overflow: hidden !important;
+    padding: 6px 8px !important;
+    padding-top: max(6px, env(safe-area-inset-top)) !important;
+    padding-bottom: max(6px, env(safe-area-inset-bottom)) !important;
+    padding-left: max(8px, env(safe-area-inset-left)) !important;
+    padding-right: max(8px, env(safe-area-inset-right)) !important;
+    gap: 0 !important;
+  }
+
+  /* O "cofre" dourado (moldura com a mesa + colunas) some do fluxo
+     normal e passa a ocupar toda a altura restante do shell */
+  .game-shell .game-board-shell {
+    flex: 1 1 auto !important;
+    min-height: 0 !important;
+    max-height: 100% !important;
+    margin-top: 0 !important;
+    display: flex !important;
+    overflow: hidden !important;
+  }
+  .game-shell .game-board-shell-inner {
+    flex: 1 1 auto !important;
+    min-height: 0 !important;
+    display: flex !important;
+    flex-direction: column !important;
+    overflow: hidden !important;
+    width: 100% !important;
+  }
+
+  .game-shell .game-main-columns {
+    flex: 1 1 auto !important;
+    min-height: 0 !important;
+    display: flex !important;
+    flex-direction: column !important;
+    flex-wrap: nowrap !important;
+    overflow: hidden !important;
+  }
+
+  .game-shell .game-table-column {
+    flex: 1 1 auto !important;
+    min-height: 0 !important;
+    width: 100% !important;
+    display: flex !important;
+    flex-direction: column !important;
+    overflow: hidden !important;
+  }
+
+  /* A mesa ocupa o espaço flexível disponível; os botões de ação ficam
+     com altura fixa, sempre visíveis logo abaixo, sem scroll */
+  .game-shell .game-table-container {
+    flex: 1 1 auto !important;
+    min-height: 0 !important;
+    height: auto !important;
+    max-height: 100% !important;
+    display: flex !important;
+    flex-direction: column !important;
+    overflow: hidden !important;
+  }
+
+  /* Não força display/flex-direction aqui: o GameTable já define isso via
+     estilo inline (linha = paisagem, coluna = retrato). Só liberamos a
+     mesa para encolher/crescer dentro do espaço disponível. */
+  .game-shell .game-table-felt {
+    flex: 1 1 auto !important;
+    min-height: 0 !important;
+    height: auto !important;
+    max-height: 100% !important;
+    overflow: hidden !important;
+  }
+
+  .game-shell .action-buttons-container {
+    flex: 0 0 auto !important;
+    margin-top: 4px !important;
+  }
+
+  .game-shell .winner-message {
+    flex: 0 0 auto !important;
+    margin-top: 4px !important;
+    padding: 4px 12px !important;
+  }
+
+  /* Crédito no rodapé não é essencial ao jogo — em telas de toque ele
+     cede o espaço para os botões de ação nunca saírem da tela */
+  .game-shell .footer-credit {
+    display: none !important;
+  }
+
+  /* ---------------- Painéis laterais viram painel deslizante -------- */
+  .game-shell .game-sidebar-column {
+    display: none !important;
+  }
+
+  .game-shell.game-shell--sidebar-open .game-sidebar-column {
+    display: flex !important;
+    position: fixed !important;
+    inset: 0 !important;
+    z-index: 500 !important;
+    width: auto !important;
+    min-width: 0 !important;
+    flex: none !important;
+    background: var(--bg-primary) !important;
+    padding: 12px !important;
+    padding-top: max(12px, env(safe-area-inset-top)) !important;
+    padding-bottom: max(12px, env(safe-area-inset-bottom)) !important;
+    overflow-y: auto !important;
+    -webkit-overflow-scrolling: touch !important;
+  }
+
+  .mobile-sidebar-toggle {
+    display: flex !important;
+    align-items: center !important;
+    justify-content: center !important;
+    position: fixed !important;
+    right: 8px !important;
+    bottom: max(8px, env(safe-area-inset-bottom)) !important;
+    width: 44px !important;
+    height: 44px !important;
+    border-radius: 50% !important;
+    border: 1px solid var(--border-gold) !important;
+    background: rgba(0, 0, 0, 0.65) !important;
+    backdrop-filter: blur(10px) !important;
+    color: var(--text-primary) !important;
+    font-size: 1.1rem !important;
+    z-index: 200 !important;
+    cursor: pointer !important;
+  }
+
+  .mobile-sidebar-close {
+    display: flex !important;
+    align-items: center !important;
+    justify-content: center !important;
+    gap: 6px !important;
+    width: 100% !important;
+    padding: 10px !important;
+    margin-bottom: 8px !important;
+    border-radius: 12px !important;
+    border: 1px solid var(--border-gold) !important;
+    background: var(--bg-button) !important;
+    color: var(--text-primary) !important;
+    font-weight: 700 !important;
+    font-size: 0.85rem !important;
+    cursor: pointer !important;
+  }
+}
+
+/* Em paisagem bem baixa (celular deitado), a mesa some ainda mais e o
+   grid de cartas/botões prioriza altura mínima confortável ao toque */
+@media (max-width: 1024px) and (orientation: landscape), (hover: none) and (pointer: coarse) and (orientation: landscape) and (max-height: 550px) {
+  .game-shell {
+    padding: 4px 6px !important;
+  }
+
+  .game-shell .action-btn {
+    min-height: clamp(34px, 9svh, 44px) !important;
+  }
+
+  .game-shell .game-table-felt {
+    padding: 4px 6px !important;
+  }
+}
